# ──────────────────────────────────────────────────────────────────────────────
# Solid VPN — Environment Configuration Example
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# NEVER use these placeholder values in production.
# ──────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info

# ── Go API ───────────────────────────────────────────────────────────────────
PORT=8080

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=solidvpn
# Replace with a strong random password — never use this placeholder.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=solidvpn

# Constructed automatically by docker-compose from the above values.
# Set explicitly when running the API outside Docker.
DATABASE_URL=postgres://solidvpn:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/solidvpn?sslmode=disable

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_HOURS=168

# ── VPN Engine ────────────────────────────────────────────────────────────────
# Shared bearer token used by the Go API to authenticate against the Rust engine.
# Generate with: openssl rand -hex 32
VPN_ENGINE_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_HEX_TOKEN

VPN_ENGINE_URL=http://vpn-engine:9090
VPN_ENGINE_CONTROL_PORT=9090

# UUID that uniquely identifies this VPN server instance.
# Generate with: uuidgen
VPN_ENGINE_SERVER_ID=REPLACE_WITH_UUID

VPN_ENGINE_WIREGUARD_INTERFACE=wg0
VPN_ENGINE_WIREGUARD_PORT=51820
VPN_ENGINE_PEER_CIDR=10.8.0.0/24
VPN_ENGINE_DNS_SERVER=1.1.1.1
VPN_ENGINE_OUTBOUND_INTERFACE=eth0

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
# Replace with a strong password before deploying.
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
