JWT_REFRESH_EXPIRY_HOURS=168

# ── VPN Engine ────────────────────────────────────────────────────────────────
# Shared bearer token used by the Go API to authenticate against the Rust engine.
# Generate with: openssl rand -hex 32
VPN_ENGINE_TOKEN=7f3c9a1e6b42d8f0c5a713e9b6d24f8a91c3e7d5b0a62f4e8c1d9a35b7e6042f

VPN_ENGINE_URL=http://vpn-engine:9090
VPN_ENGINE_CONTROL_PORT=9090

# UUID that uniquely identifies this VPN server instance.
# Generate with: uuidgen
VPN_ENGINE_SERVER_ID="36e8de75-bd28-49d7-8450-b97213c66c9c"

VPN_ENGINE_WIREGUARD_INTERFACE=wg0
VPN_ENGINE_WIREGUARD_PORT=51820
VPN_ENGINE_PEER_CIDR=10.8.0.0/24
VPN_ENGINE_DNS_SERVER=1.1.1.1
VPN_ENGINE_OUTBOUND_INTERFACE=eth0

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
# Replace with a strong password before deploying.
GRAFANA_PASSWORD=admin
